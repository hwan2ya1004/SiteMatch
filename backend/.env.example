# Google AI Studio API 키 (무료 발급: https://aistudio.google.com)
GEMINI_API_KEY=

# 공공데이터포털 API 키 (무료 발급: https://www.data.go.kr)
# 없으면 비워두세요 - 내장 데이터로 동작합니다
PUBLIC_DATA_API_KEY=your_public_data_api_key_here

# 브이월드(VWorld) API 키 (무료 발급: https://www.vworld.kr)
# 산업단지 실측 경계(geometry)·위경도 데이터 조회용. 없으면 비워두세요.
VWORLD_API_KEY=

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 대시보드 접근 키 (관공서/관리자 화면 게이트)
ADMIN_KEY=change_me_admin
GOV_KEY=change_me_gov

# 카카오맵 JavaScript 키 (developers.kakao.com → 내 애플리케이션 → 앱 키)
# 발급받은 앱에 배포 도메인을 플랫폼(Web)으로 등록해야 지도가 표시됩니다.
KAKAO_MAP_KEY=
